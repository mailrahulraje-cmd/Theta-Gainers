# ==============================================
# TRADING SYSTEM CONFIGURATION
# ==============================================

# ----------------------------------------------
# MODE SELECTION
# ----------------------------------------------
# DATA_MODE: Where to get market data from
#   - LIVE: Real-time data from Angel One WebSocket
#   - REPLAY: Historical tick data for backtesting
DATA_MODE=LIVE

# TRADING_MODE: How to execute orders
#   - PAPER: Simulated orders (no real money)
#   - LIVE: Real orders on exchange (REAL MONEY!)
TRADING_MODE=PAPER

# ----------------------------------------------
# ANGEL ONE CREDENTIALS (Required for LIVE modes)
# ----------------------------------------------
ANGEL_API_KEY=J7Q8GZFy
ANGEL_CLIENT_CODE=A300707
ANGEL_PASSWORD=6890
ANGEL_TOTP_SECRET=HPRFM22K3ZCDR4YTEG6W6TYNTQ

# ----------------------------------------------
# REPLAY CONFIGURATION (for DATA_MODE=REPLAY)
# ----------------------------------------------
REPLAY_START_DATE=2026-02-09
REPLAY_END_DATE=2026-02-09
REPLAY_SPEED=30

# ----------------------------------------------
# POSITION SIZING
# ----------------------------------------------
# Number of lots to trade
LOTS=1

# ----------------------------------------------
# ORDER EXECUTION (for TRADING_MODE=LIVE)
# ----------------------------------------------
# Order type: MARKET or LIMIT
ORDER_TYPE=MARKET

# For LIMIT orders: price offset percentage
LIMIT_PRICE_OFFSET_PERCENT=0.5

# Order variety: NORMAL, STOPLOSS, AMO, ROBO
ORDER_VARIETY=NORMAL

# Product type: INTRADAY, DELIVERY, CARRYFORWARD
PRODUCT_TYPE=INTRADAY

# Max retries for failed orders
ORDER_MAX_RETRIES=3

# Delay between retries (seconds)
ORDER_RETRY_DELAY=1.0

# ----------------------------------------------
# RISK MANAGEMENT
# ----------------------------------------------
# Maximum daily loss limit (₹)
MAX_DAILY_LOSS=10000

# Maximum single trade loss (₹)
MAX_TRADE_LOSS=6000

# Enable circuit breaker (auto-stop on loss limit)
ENABLE_CIRCUIT_BREAKER=true

# ----------------------------------------------
# TELEGRAM NOTIFICATIONS
# ----------------------------------------------
TELEGRAM_BOT_TOKEN=8358976050:AAHLwac6iQDjvfue3eNUcaRZnBjULtUmzXc
TELEGRAM_CHAT_ID=8356843878
TELEGRAM_SNAPSHOT_INTERVAL=60
TELEGRAM_SNAPSHOT_LINES=60

# ----------------------------------------------
# SYSTEM CONFIGURATION
# ----------------------------------------------
# Reset strategy state on startup (true/false)
RESET_STATE_ON_START=false
